 RowBox[{
  RowBox[{"pT", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"s", " ", "+", " ", 
         SuperscriptBox["mH", "2"], "-", 
         SuperscriptBox["mZ", "2"]}], ")"}], "2"], 
      RowBox[{"4", "s", " ", 
       SuperscriptBox[
        RowBox[{"Cosh", "[", "y", "]"}], "2"]}]], "-", " ", 
     SuperscriptBox["mH", "2"]}], " ", ")"}], "/.", 
   RowBox[{"s", "->", 
    SuperscriptBox[
     RowBox[{"(", 
