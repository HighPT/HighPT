Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConfidenceInterval", "[", 
    RowBox[{"\[Chi]2_", ",", "coefName_", ",", " ", "confLevel_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Chi]2values", ",", " ", "\[Chi]2min"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"\[Chi]2min", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"First", "@", 
         RowBox[{"FindMinimum", "[", 
