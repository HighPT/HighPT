     RowBox[{"\"\<Hq1\>\"", "->", " ", "\"\<C1Hq\>\""}], ",", 
     RowBox[{"\"\<Hq3\>\"", "->", " ", "\"\<C3Hq\>\""}], ",", " ", 
     RowBox[{"\"\<Hu\>\"", "->", " ", "\"\<CHu\>\""}], ",", " ", 
