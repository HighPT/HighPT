Cell[BoxData[
 RowBox[{
  RowBox[{"pT", "[", "y_", "]"}], " ", ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SuperscriptBox[
         RowBox[{"Cosh", "[", "y", "]"}], "2"]}]], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"s", " ", "+", " ", 
            SuperscriptBox[
             RowBox[{"Mass", "[", "\"\<Higgs\>\"", "]"}], "2"], "-", 
            SuperscriptBox[
             RowBox[{"Mass", "[", "\"\<ZBoson\>\"", "]"}], "2"]}], ")"}], 
          "2"], "s"], "-", " ", 
        RowBox[{"4", " ", 
         SuperscriptBox[
          RowBox[{"Mass", "[", "\"\<Higgs\>\"", "]"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"Cosh", "[", "y", "]"}], "2"]}]}], ")"}]}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{"s", "->", " ", "1000"}], "\[IndentingNewLine]", "}"}]}], "/.", 
   RowBox[{"GetParameters", "[", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.969097269624201*^9, 3.969097410941121*^9}, {
   3.9690975277192*^9, 3.9690975284836197`*^9}, {3.969097608382407*^9, 
