Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"selectEFTterm", "[", 
    RowBox[{"\[Sigma]_", ",", " ", "coefs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"coefs", " ", "===", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
     RowBox[{"\[Sigma]", "/.", 
      RowBox[{
       RowBox[{"WC", "[", "___", "]"}], ":>", " ", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"\[Sigma]", ",", " ", 
        RowBox[{"Times", "@@", "coefs"}]}], "]"}], "/.", 
      RowBox[{
       RowBox[{"WC", "[", "___", "]"}], "->", "0"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.971196374993438*^9, 3.971196457209241*^9}, {
