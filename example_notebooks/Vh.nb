   RowBox[{"selectEFTterm", "[", 
    RowBox[{"\[Sigma]_", ",", " ", "coefs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"coefs", " ", "===", " ", 
      RowBox[{"{", "}"}]}], ",", " ", 
