      RowBox[{
       RowBox[{"WC", "[", "___", "]"}], ":>", " ", "0"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"\[Sigma]", ",", " ", 
        RowBox[{"Times", "@@", "coefs"}]}], "]"}], "/.", 
