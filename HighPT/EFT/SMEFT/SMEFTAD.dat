      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 2}]) + 
    (2*Conjugate[WC["Hud", {3, 3}]]*(Conjugate[Yukawa["u", {1, 1}]]*
        Yukawa["d", {1, 2}] + Conjugate[Yukawa["u", {2, 1}]]*
