      Conjugate[Yukawa["d", {2, 3}]]*Yukawa["d", {2, 2}] + 
      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 2}]) + 
    WC["ud1", {1, 3, 2, 2}]*(Conjugate[Yukawa["d", {1, 3}]]*
       Yukawa["d", {1, 2}] + Conjugate[Yukawa["d", {2, 3}]]*
