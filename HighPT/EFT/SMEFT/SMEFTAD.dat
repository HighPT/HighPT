       WC["lq3", {3, 3, 2, 3}]))/3 + 
    (2*Param["g2"]^2*(Conjugate[WC["qq1", {1, 2, 3, 1}]] - 
       Conjugate[WC["qq3", {1, 2, 3, 1}]] + WC["qq1", {2, 2, 2, 3}] + 
       WC["qq1", {2, 3, 3, 3}] - WC["qq3", {2, 2, 2, 3}] - 
