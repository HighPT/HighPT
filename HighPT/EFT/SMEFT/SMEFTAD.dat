       Yukawa["d", {2, 3}] + Conjugate[Yukawa["e", {2, 2}]]*
       WC["ledq", {2, 2, 3, 3}]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["e", {2, 3}]]*WC["ledq", {2, 3, 3, 3}]*
       Yukawa["d", {2, 3}] + Conjugate[WC["ledq", {2, 1, 1, 2}]]*
       Conjugate[Yukawa["d", {3, 1}]]*Yukawa["e", {2, 1}] + 
      Conjugate[WC["ledq", {2, 1, 2, 2}]]*Conjugate[Yukawa["d", {3, 2}]]*
       Yukawa["e", {2, 1}] + Conjugate[WC["ledq", {2, 1, 3, 2}]]*
       Conjugate[Yukawa["d", {3, 3}]]*Yukawa["e", {2, 1}] + 
      Conjugate[WC["ledq", {2, 2, 1, 2}]]*Conjugate[Yukawa["d", {3, 1}]]*
       Yukawa["e", {2, 2}] + Conjugate[WC["ledq", {2, 2, 2, 2}]]*
       Conjugate[Yukawa["d", {3, 2}]]*Yukawa["e", {2, 2}] + 
      Conjugate[WC["ledq", {2, 2, 3, 2}]]*Conjugate[Yukawa["d", {3, 3}]]*
       Yukawa["e", {2, 2}] + Conjugate[WC["ledq", {2, 3, 1, 2}]]*
       Conjugate[Yukawa["d", {3, 1}]]*Yukawa["e", {2, 3}] + 
      Conjugate[WC["ledq", {2, 3, 2, 2}]]*Conjugate[Yukawa["d", {3, 2}]]*
       Yukawa["e", {2, 3}] + Conjugate[WC["ledq", {2, 3, 3, 2}]]*
       Conjugate[Yukawa["d", {3, 3}]]*Yukawa["e", {2, 3}])/4 + 
    (WC["lq3", {1, 2, 2, 3}]*(Conjugate[Yukawa["e", {1, 1}]]*
