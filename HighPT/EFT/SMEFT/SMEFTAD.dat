        Yukawa["d", {2, 1}] + Conjugate[Yukawa["d", {3, 2}]]*
        Yukawa["d", {2, 2}] + Conjugate[Yukawa["d", {3, 3}]]*
        Yukawa["d", {2, 3}] + Conjugate[Yukawa["u", {3, 1}]]*
        Yukawa["u", {2, 1}] + Conjugate[Yukawa["u", {3, 2}]]*
        Yukawa["u", {2, 2}] + Conjugate[Yukawa["u", {3, 3}]]*
        Yukawa["u", {2, 3}]))/2 + (WC["lq3", {2, 2, 3, 3}]*
      (Conjugate[Yukawa["d", {3, 1}]]*Yukawa["d", {2, 1}] + 
       Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {2, 2}] + 
