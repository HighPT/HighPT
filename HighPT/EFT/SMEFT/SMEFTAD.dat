      WC["quqd1", {1, 2, 1, 3}]) - Conjugate[Yukawa["d", {2, 2}]]*
     Conjugate[Yukawa["u", {1, 1}]]*WC["quqd1", {1, 2, 2, 3}] - 
    Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {1, 1}]]*
     WC["quqd1", {1, 2, 3, 3}] - Conjugate[Yukawa["d", {1, 2}]]*
     Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {2, 2, 1, 3}] - 
    Conjugate[Yukawa["d", {2, 2}]]*Conjugate[Yukawa["u", {2, 1}]]*
     WC["quqd1", {2, 2, 2, 3}] - Conjugate[Yukawa["d", {3, 2}]]*
     Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {2, 2, 3, 3}] - 
    Conjugate[Yukawa["d", {1, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
     WC["quqd1", {3, 2, 1, 3}] - Conjugate[Yukawa["d", {2, 2}]]*
     Conjugate[Yukawa["u", {3, 1}]]*WC["quqd1", {3, 2, 2, 3}] - 
    Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
     WC["quqd1", {3, 2, 3, 3}] - 
    (8*(Param["g1"]^2*WC["ud1", {1, 2, 2, 3}] - Param["g3"]^2*
        WC["ud8", {1, 2, 2, 3}]))/3 + WC["ud1", {1, 2, 1, 3}]*
     (Conjugate[Yukawa["d", {1, 2}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {2, 2}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {3, 1}]) + 
    WC["ud1", {1, 2, 2, 3}]*(Conjugate[Yukawa["d", {1, 2}]]*
       Yukawa["d", {1, 2}] + Conjugate[Yukawa["d", {2, 2}]]*
       Yukawa["d", {2, 2}] + Conjugate[Yukawa["d", {3, 2}]]*
       Yukawa["d", {3, 2}]) + WC["ud1", {1, 2, 2, 1}]*
     (Conjugate[Yukawa["d", {1, 1}]]*Yukawa["d", {1, 3}] + 
      Conjugate[Yukawa["d", {2, 1}]]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["d", {3, 1}]]*Yukawa["d", {3, 3}]) + 
    2*WC["Hu", {1, 2}]*(Conjugate[Yukawa["d", {1, 2}]]*Yukawa["d", {1, 3}] + 
      Conjugate[Yukawa["d", {2, 2}]]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {3, 3}]) + 
    WC["ud1", {1, 2, 2, 2}]*(Conjugate[Yukawa["d", {1, 2}]]*
       Yukawa["d", {1, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
       Yukawa["d", {2, 3}] + Conjugate[Yukawa["d", {3, 2}]]*
       Yukawa["d", {3, 3}]) + WC["ud1", {1, 2, 3, 3}]*
     (Conjugate[Yukawa["d", {1, 2}]]*Yukawa["d", {1, 3}] + 
      Conjugate[Yukawa["d", {2, 2}]]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {3, 3}]) + 
    WC["ud1", {1, 2, 2, 3}]*(Conjugate[Yukawa["d", {1, 3}]]*
       Yukawa["d", {1, 3}] + Conjugate[Yukawa["d", {2, 3}]]*
       Yukawa["d", {2, 3}] + Conjugate[Yukawa["d", {3, 3}]]*
       Yukawa["d", {3, 3}]) + (2*Conjugate[WC["Hud", {2, 2}]]*
      (Conjugate[Yukawa["u", {1, 1}]]*Yukawa["d", {1, 3}] + 
       Conjugate[Yukawa["u", {2, 1}]]*Yukawa["d", {2, 3}] + 
       Conjugate[Yukawa["u", {3, 1}]]*Yukawa["d", {3, 3}]))/3 - 
    2*(Conjugate[WC["qu1", {1, 2, 2, 1}]]*Conjugate[Yukawa["d", {2, 2}]]*
       Yukawa["d", {1, 3}] + Conjugate[WC["qu1", {1, 3, 2, 1}]]*
       Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {1, 3}] + 
      Conjugate[Yukawa["d", {1, 2}]]*WC["qu1", {1, 1, 1, 2}]*
       Yukawa["d", {1, 3}] + Conjugate[WC["qu1", {2, 3, 2, 1}]]*
       Conjugate[Yukawa["d", {3, 2}]]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["d", {1, 2}]]*WC["qu1", {1, 2, 1, 2}]*
       Yukawa["d", {2, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
       WC["qu1", {2, 2, 1, 2}]*Yukawa["d", {2, 3}] + 
      Conjugate[Yukawa["d", {1, 2}]]*WC["qu1", {1, 3, 1, 2}]*
       Yukawa["d", {3, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
       WC["qu1", {2, 3, 1, 2}]*Yukawa["d", {3, 3}] + 
      Conjugate[Yukawa["d", {3, 2}]]*WC["qu1", {3, 3, 1, 2}]*
       Yukawa["d", {3, 3}]) - Conjugate[WC["quqd1", {1, 1, 1, 2}]]*
     Yukawa["d", {1, 3}]*Yukawa["u", {1, 2}] - 
    Conjugate[WC["quqd1", {1, 1, 2, 2}]]*Yukawa["d", {2, 3}]*
     Yukawa["u", {1, 2}] - Conjugate[WC["quqd1", {1, 1, 3, 2}]]*
     Yukawa["d", {3, 3}]*Yukawa["u", {1, 2}] - 
    Conjugate[WC["quqd1", {2, 1, 1, 2}]]*Yukawa["d", {1, 3}]*
     Yukawa["u", {2, 2}] - Conjugate[WC["quqd1", {2, 1, 2, 2}]]*
     Yukawa["d", {2, 3}]*Yukawa["u", {2, 2}] - 
    Conjugate[WC["quqd1", {2, 1, 3, 2}]]*Yukawa["d", {3, 3}]*
     Yukawa["u", {2, 2}] + WC["ud1", {1, 2, 2, 3}]*
     (Conjugate[Yukawa["u", {1, 1}]]*Yukawa["u", {1, 1}] + 
      Conjugate[Yukawa["u", {2, 1}]]*Yukawa["u", {2, 1}] + 
      Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {3, 1}]) - 
    Conjugate[WC["quqd1", {3, 1, 1, 2}]]*Yukawa["d", {1, 3}]*
     Yukawa["u", {3, 2}] - Conjugate[WC["quqd1", {3, 1, 2, 2}]]*
     Yukawa["d", {2, 3}]*Yukawa["u", {3, 2}] - 
    Conjugate[WC["quqd1", {3, 1, 3, 2}]]*Yukawa["d", {3, 3}]*
     Yukawa["u", {3, 2}] + (2*WC["Hud", {1, 3}]*
      (Conjugate[Yukawa["d", {1, 2}]]*Yukawa["u", {1, 2}] + 
       Conjugate[Yukawa["d", {2, 2}]]*Yukawa["u", {2, 2}] + 
       Conjugate[Yukawa["d", {3, 2}]]*Yukawa["u", {3, 2}]))/3 - 
    2*WC["Hd", {2, 3}]*(Conjugate[Yukawa["u", {1, 1}]]*Yukawa["u", {1, 2}] + 
      Conjugate[Yukawa["u", {2, 1}]]*Yukawa["u", {2, 2}] + 
      Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {3, 2}]) + 
    WC["ud1", {1, 1, 2, 3}]*(Conjugate[Yukawa["u", {1, 1}]]*
       Yukawa["u", {1, 2}] + Conjugate[Yukawa["u", {2, 1}]]*
       Yukawa["u", {2, 2}] + Conjugate[Yukawa["u", {3, 1}]]*
       Yukawa["u", {3, 2}]) + WC["ud1", {2, 2, 2, 3}]*
     (Conjugate[Yukawa["u", {1, 1}]]*Yukawa["u", {1, 2}] + 
      Conjugate[Yukawa["u", {2, 1}]]*Yukawa["u", {2, 2}] + 
      Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {3, 2}]) + 
    WC["ud1", {1, 2, 2, 3}]*(Conjugate[Yukawa["u", {1, 2}]]*
       Yukawa["u", {1, 2}] + Conjugate[Yukawa["u", {2, 2}]]*
       Yukawa["u", {2, 2}] + Conjugate[Yukawa["u", {3, 2}]]*
       Yukawa["u", {3, 2}]) + WC["ud1", {1, 3, 2, 3}]*
     (Conjugate[Yukawa["u", {1, 3}]]*Yukawa["u", {1, 2}] + 
      Conjugate[Yukawa["u", {2, 3}]]*Yukawa["u", {2, 2}] + 
      Conjugate[Yukawa["u", {3, 3}]]*Yukawa["u", {3, 2}]) - 
    2*(Conjugate[WC["qd1", {1, 2, 3, 2}]]*Conjugate[Yukawa["u", {2, 1}]]*
       Yukawa["u", {1, 2}] + Conjugate[WC["qd1", {1, 3, 3, 2}]]*
       Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {1, 2}] + 
      Conjugate[Yukawa["u", {1, 1}]]*WC["qd1", {1, 1, 2, 3}]*
       Yukawa["u", {1, 2}] + Conjugate[WC["qd1", {2, 3, 3, 2}]]*
       Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {2, 2}] + 
      Conjugate[Yukawa["u", {1, 1}]]*WC["qd1", {1, 2, 2, 3}]*
       Yukawa["u", {2, 2}] + Conjugate[Yukawa["u", {2, 1}]]*
       WC["qd1", {2, 2, 2, 3}]*Yukawa["u", {2, 2}] + 
      Conjugate[Yukawa["u", {1, 1}]]*WC["qd1", {1, 3, 2, 3}]*
       Yukawa["u", {3, 2}] + Conjugate[Yukawa["u", {2, 1}]]*
       WC["qd1", {2, 3, 2, 3}]*Yukawa["u", {3, 2}] + 
      Conjugate[Yukawa["u", {3, 1}]]*WC["qd1", {3, 3, 2, 3}]*
       Yukawa["u", {3, 2}]) + 
    (Conjugate[Yukawa["d", {1, 2}]]*Conjugate[Yukawa["u", {1, 1}]]*
       WC["quqd1", {1, 2, 1, 3}] + Conjugate[Yukawa["d", {1, 2}]]*
       Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {1, 2, 2, 3}] + 
      Conjugate[Yukawa["d", {1, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
       WC["quqd1", {1, 2, 3, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
       Conjugate[Yukawa["u", {1, 1}]]*WC["quqd1", {2, 2, 1, 3}] + 
      Conjugate[Yukawa["d", {2, 2}]]*Conjugate[Yukawa["u", {2, 1}]]*
       WC["quqd1", {2, 2, 2, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
       Conjugate[Yukawa["u", {3, 1}]]*WC["quqd1", {2, 2, 3, 3}] + 
      Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {1, 1}]]*
       WC["quqd1", {3, 2, 1, 3}] + Conjugate[Yukawa["d", {3, 2}]]*
       Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {3, 2, 2, 3}] + 
      Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
       WC["quqd1", {3, 2, 3, 3}] + 
      (4*(Conjugate[Yukawa["d", {1, 2}]]*Conjugate[Yukawa["u", {1, 1}]]*
          WC["quqd8", {1, 2, 1, 3}] + Conjugate[Yukawa["d", {1, 2}]]*
          Conjugate[Yukawa["u", {2, 1}]]*WC["quqd8", {1, 2, 2, 3}] + 
         Conjugate[Yukawa["d", {1, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
          WC["quqd8", {1, 2, 3, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
          Conjugate[Yukawa["u", {1, 1}]]*WC["quqd8", {2, 2, 1, 3}] + 
         Conjugate[Yukawa["d", {2, 2}]]*Conjugate[Yukawa["u", {2, 1}]]*
          WC["quqd8", {2, 2, 2, 3}] + Conjugate[Yukawa["d", {2, 2}]]*
          Conjugate[Yukawa["u", {3, 1}]]*WC["quqd8", {2, 2, 3, 3}] + 
         Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {1, 1}]]*
          WC["quqd8", {3, 2, 1, 3}] + Conjugate[Yukawa["d", {3, 2}]]*
          Conjugate[Yukawa["u", {2, 1}]]*WC["quqd8", {3, 2, 2, 3}] + 
         Conjugate[Yukawa["d", {3, 2}]]*Conjugate[Yukawa["u", {3, 1}]]*
          WC["quqd8", {3, 2, 3, 3}]))/3 + 
      Conjugate[WC["quqd1", {1, 1, 1, 2}]]*Yukawa["d", {1, 3}]*
       Yukawa["u", {1, 2}] + Conjugate[WC["quqd1", {2, 1, 1, 2}]]*
       Yukawa["d", {2, 3}]*Yukawa["u", {1, 2}] + 
      Conjugate[WC["quqd1", {3, 1, 1, 2}]]*Yukawa["d", {3, 3}]*
       Yukawa["u", {1, 2}] + Conjugate[WC["quqd1", {1, 1, 2, 2}]]*
       Yukawa["d", {1, 3}]*Yukawa["u", {2, 2}] + 
      Conjugate[WC["quqd1", {2, 1, 2, 2}]]*Yukawa["d", {2, 3}]*
       Yukawa["u", {2, 2}] + Conjugate[WC["quqd1", {3, 1, 2, 2}]]*
       Yukawa["d", {3, 3}]*Yukawa["u", {2, 2}] + 
      Conjugate[WC["quqd1", {1, 1, 3, 2}]]*Yukawa["d", {1, 3}]*
       Yukawa["u", {3, 2}] + Conjugate[WC["quqd1", {2, 1, 3, 2}]]*
       Yukawa["d", {2, 3}]*Yukawa["u", {3, 2}] + 
      Conjugate[WC["quqd1", {3, 1, 3, 2}]]*Yukawa["d", {3, 3}]*
       Yukawa["u", {3, 2}] + (4*(Conjugate[WC["quqd8", {1, 1, 1, 2}]]*
          Yukawa["d", {1, 3}]*Yukawa["u", {1, 2}] + 
         Conjugate[WC["quqd8", {2, 1, 1, 2}]]*Yukawa["d", {2, 3}]*
          Yukawa["u", {1, 2}] + Conjugate[WC["quqd8", {3, 1, 1, 2}]]*
          Yukawa["d", {3, 3}]*Yukawa["u", {1, 2}] + 
         Conjugate[WC["quqd8", {1, 1, 2, 2}]]*Yukawa["d", {1, 3}]*
          Yukawa["u", {2, 2}] + Conjugate[WC["quqd8", {2, 1, 2, 2}]]*
          Yukawa["d", {2, 3}]*Yukawa["u", {2, 2}] + 
         Conjugate[WC["quqd8", {3, 1, 2, 2}]]*Yukawa["d", {3, 3}]*
          Yukawa["u", {2, 2}] + Conjugate[WC["quqd8", {1, 1, 3, 2}]]*
          Yukawa["d", {1, 3}]*Yukawa["u", {3, 2}] + 
         Conjugate[WC["quqd8", {2, 1, 3, 2}]]*Yukawa["d", {2, 3}]*
          Yukawa["u", {3, 2}] + Conjugate[WC["quqd8", {3, 1, 3, 2}]]*
          Yukawa["d", {3, 3}]*Yukawa["u", {3, 2}]))/3)/3 + 
    Conjugate[WC["ud1", {2, 3, 3, 2}]]*(Conjugate[Yukawa["u", {1, 1}]]*
       Yukawa["u", {1, 3}] + Conjugate[Yukawa["u", {2, 1}]]*
       Yukawa["u", {2, 3}] + Conjugate[Yukawa["u", {3, 1}]]*
       Yukawa["u", {3, 3}])
 
SMEFTAD[WC["ud1", {1, 2, 3, 1}]] = 
   -(Conjugate[Yukawa["d", {1, 3}]]*Conjugate[Yukawa["u", {1, 1}]]*
      WC["quqd1", {1, 2, 1, 1}]) - Conjugate[Yukawa["d", {2, 3}]]*
     Conjugate[Yukawa["u", {1, 1}]]*WC["quqd1", {1, 2, 2, 1}] - 
    Conjugate[Yukawa["d", {3, 3}]]*Conjugate[Yukawa["u", {1, 1}]]*
     WC["quqd1", {1, 2, 3, 1}] - Conjugate[Yukawa["d", {1, 3}]]*
     Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {2, 2, 1, 1}] - 
    Conjugate[Yukawa["d", {2, 3}]]*Conjugate[Yukawa["u", {2, 1}]]*
     WC["quqd1", {2, 2, 2, 1}] - Conjugate[Yukawa["d", {3, 3}]]*
     Conjugate[Yukawa["u", {2, 1}]]*WC["quqd1", {2, 2, 3, 1}] - 
    Conjugate[Yukawa["d", {1, 3}]]*Conjugate[Yukawa["u", {3, 1}]]*
     WC["quqd1", {3, 2, 1, 1}] - Conjugate[Yukawa["d", {2, 3}]]*
     Conjugate[Yukawa["u", {3, 1}]]*WC["quqd1", {3, 2, 2, 1}] - 
    Conjugate[Yukawa["d", {3, 3}]]*Conjugate[Yukawa["u", {3, 1}]]*
     WC["quqd1", {3, 2, 3, 1}] - 
    (8*(Param["g1"]^2*WC["ud1", {1, 2, 3, 1}] - Param["g3"]^2*
        WC["ud8", {1, 2, 3, 1}]))/3 + WC["ud1", {1, 2, 3, 1}]*
     (Conjugate[Yukawa["d", {1, 1}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {2, 1}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {3, 1}]]*Yukawa["d", {3, 1}]) + 
    WC["ud1", {1, 2, 3, 2}]*(Conjugate[Yukawa["d", {1, 2}]]*
       Yukawa["d", {1, 1}] + Conjugate[Yukawa["d", {2, 2}]]*
       Yukawa["d", {2, 1}] + Conjugate[Yukawa["d", {3, 2}]]*
       Yukawa["d", {3, 1}]) + 2*WC["Hu", {1, 2}]*
     (Conjugate[Yukawa["d", {1, 3}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {2, 3}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 1}]) + 
    WC["ud1", {1, 2, 1, 1}]*(Conjugate[Yukawa["d", {1, 3}]]*
       Yukawa["d", {1, 1}] + Conjugate[Yukawa["d", {2, 3}]]*
       Yukawa["d", {2, 1}] + Conjugate[Yukawa["d", {3, 3}]]*
       Yukawa["d", {3, 1}]) + WC["ud1", {1, 2, 3, 3}]*
     (Conjugate[Yukawa["d", {1, 3}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {2, 3}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 1}]) + 
    (2*Conjugate[WC["Hud", {2, 3}]]*(Conjugate[Yukawa["u", {1, 1}]]*
        Yukawa["d", {1, 1}] + Conjugate[Yukawa["u", {2, 1}]]*
        Yukawa["d", {2, 1}] + Conjugate[Yukawa["u", {3, 1}]]*
        Yukawa["d", {3, 1}]))/3 - 
    2*(Conjugate[WC["qu1", {1, 2, 2, 1}]]*Conjugate[Yukawa["d", {2, 3}]]*
       Yukawa["d", {1, 1}] + Conjugate[WC["qu1", {1, 3, 2, 1}]]*
       Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {1, 3}]]*WC["qu1", {1, 1, 1, 2}]*
       Yukawa["d", {1, 1}] + Conjugate[WC["qu1", {2, 3, 2, 1}]]*
       Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {1, 3}]]*WC["qu1", {1, 2, 1, 2}]*
       Yukawa["d", {2, 1}] + Conjugate[Yukawa["d", {2, 3}]]*
       WC["qu1", {2, 2, 1, 2}]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {1, 3}]]*WC["qu1", {1, 3, 1, 2}]*
       Yukawa["d", {3, 1}] + Conjugate[Yukawa["d", {2, 3}]]*
       WC["qu1", {2, 3, 1, 2}]*Yukawa["d", {3, 1}] + 
      Conjugate[Yukawa["d", {3, 3}]]*WC["qu1", {3, 3, 1, 2}]*
       Yukawa["d", {3, 1}]) + WC["ud1", {1, 2, 2, 1}]*
     (Conjugate[Yukawa["d", {1, 3}]]*Yukawa["d", {1, 2}] + 
      Conjugate[Yukawa["d", {2, 3}]]*Yukawa["d", {2, 2}] + 
      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 2}]) + 
    WC["ud1", {1, 2, 3, 1}]*(Conjugate[Yukawa["d", {1, 3}]]*
       Yukawa["d", {1, 3}] + Conjugate[Yukawa["d", {2, 3}]]*
       Yukawa["d", {2, 3}] + Conjugate[Yukawa["d", {3, 3}]]*
       Yukawa["d", {3, 3}]) - Conjugate[WC["quqd1", {1, 1, 1, 3}]]*
     Yukawa["d", {1, 1}]*Yukawa["u", {1, 2}] - 
    Conjugate[WC["quqd1", {1, 1, 2, 3}]]*Yukawa["d", {2, 1}]*
     Yukawa["u", {1, 2}] - Conjugate[WC["quqd1", {1, 1, 3, 3}]]*
     Yukawa["d", {3, 1}]*Yukawa["u", {1, 2}] - 
    Conjugate[WC["quqd1", {2, 1, 1, 3}]]*Yukawa["d", {1, 1}]*
     Yukawa["u", {2, 2}] - Conjugate[WC["quqd1", {2, 1, 2, 3}]]*
     Yukawa["d", {2, 1}]*Yukawa["u", {2, 2}] - 
    Conjugate[WC["quqd1", {2, 1, 3, 3}]]*Yukawa["d", {3, 1}]*
     Yukawa["u", {2, 2}] + WC["ud1", {1, 2, 3, 1}]*
     (Conjugate[Yukawa["u", {1, 1}]]*Yukawa["u", {1, 1}] + 
      Conjugate[Yukawa["u", {2, 1}]]*Yukawa["u", {2, 1}] + 
      Conjugate[Yukawa["u", {3, 1}]]*Yukawa["u", {3, 1}]) - 
    Conjugate[WC["quqd1", {3, 1, 1, 3}]]*Yukawa["d", {1, 1}]*
