    Conjugate[Yukawa["d", {3, 3}]]*Conjugate[Yukawa["u", {3, 1}]]*
     WC["quqd1", {3, 3, 3, 2}] - 
    (8*(Param["g1"]^2*WC["ud1", {1, 3, 3, 2}] - Param["g3"]^2*
        WC["ud8", {1, 3, 3, 2}]))/3 + WC["ud1", {1, 3, 1, 2}]*
     (Conjugate[Yukawa["d", {1, 3}]]*Yukawa["d", {1, 1}] + 
      Conjugate[Yukawa["d", {2, 3}]]*Yukawa["d", {2, 1}] + 
      Conjugate[Yukawa["d", {3, 3}]]*Yukawa["d", {3, 1}]) + 
