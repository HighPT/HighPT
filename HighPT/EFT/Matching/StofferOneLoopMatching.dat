OneLoopMatching[HighPT`PackageScope`WCLS["\[Nu]eVLL", 
     {pi_, ri_, si_, ti_}]] := 
   ((3*KroneckerDelta[pi, ri]*KroneckerDelta[si, ti]*
       Log[\[Mu]W^2/Mass["H"]^2]*Mass["H"]^2*(Mass["H"]^2 - 
        2*Mass["ZBoson"]^2)*(-2*Mass["WBoson"]^2 + Mass["ZBoson"]^2))/
      (16*(Mass["H"] - Mass["ZBoson"])*Mass["ZBoson"]^2*
       (Mass["H"] + Mass["ZBoson"])*Param["vev"]^4) + 
     (3*KroneckerDelta[pi, ri]*KroneckerDelta[si, ti]*
       Log[\[Mu]W^2/Mass["ZBoson"]^2]*Mass["ZBoson"]^2*
       (3*Mass["H"]^2 - 2*Mass["ZBoson"]^2)*(-2*Mass["WBoson"]^2 + 
        Mass["ZBoson"]^2))/(16*Mass["H"]^2*(Mass["H"] - Mass["ZBoson"])*
       (Mass["H"] + Mass["ZBoson"])*Param["vev"]^4) - 
     (KroneckerDelta[pi, ri]*KroneckerDelta[si, ti]*
       Log[\[Mu]W^2/Mass["WBoson"]^2]*(12*Mass["WBoson"]^6*Mass["ZBoson"]^2 - 
        6*Mass["WBoson"]^4*Mass["ZBoson"]^4 + Mass["H"]^2*
         (28*Mass["WBoson"]^6 - 36*Mass["WBoson"]^4*Mass["ZBoson"]^2 + 
          5*Mass["WBoson"]^2*Mass["ZBoson"]^4)))/(8*Mass["H"]^2*
       Mass["ZBoson"]^4*Param["vev"]^4) + 
     (KroneckerDelta[pi, ri]*KroneckerDelta[si, ti]*Log[\[Mu]W^2/Mass["t"]^2]*
       (-108*Mass["t"]^4*Mass["ZBoson"]^2*(-2*Mass["WBoson"]^2 + 
          Mass["ZBoson"]^2) + Mass["H"]^2*(64*Mass["WBoson"]^6 - 
          2*Mass["WBoson"]^2*(27*Mass["t"]^2 + 52*Mass["WBoson"]^2)*
           Mass["ZBoson"]^2 + (27*Mass["t"]^2 + 40*Mass["WBoson"]^2)*
           Mass["ZBoson"]^4)))/(72*Mass["H"]^2*Mass["ZBoson"]^4*
       Param["vev"]^4) + (KroneckerDelta[pi, ri]*KroneckerDelta[si, ti]*
       (21*Mass["H"]^4*Mass["ZBoson"]^2*(-2*Mass["WBoson"]^2 + 
          Mass["ZBoson"]^2) + 12*Mass["ZBoson"]^2*(-2*Mass["WBoson"]^2 + 
          Mass["ZBoson"]^2)*(-12*Mass["t"]^4 + 2*Mass["WBoson"]^4 + 
          Mass["ZBoson"]^4) + Mass["H"]^2*(-32*Mass["WBoson"]^6 + 
          32*Mass["WBoson"]^4*Mass["ZBoson"]^2 + 114*Mass["WBoson"]^2*
           Mass["ZBoson"]^4 + 3*Mass["ZBoson"]^6)))/
      (96*Mass["H"]^2*Mass["ZBoson"]^4*Param["vev"]^4) - 
     (Conjugate[WC["uW", {3, 3}]]*KroneckerDelta[pi, ri]*
       KroneckerDelta[si, ti]*Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]*
       (16*Mass["WBoson"]^5 - 21*Mass["WBoson"]^3*Mass["ZBoson"]^2 + 
        5*Mass["WBoson"]*Mass["ZBoson"]^4))/(4*Sqrt[2]*Mass["ZBoson"]^4*
       Param["vev"]^2) + (Conjugate[WC["uB", {3, 3}]]*KroneckerDelta[pi, ri]*
       KroneckerDelta[si, ti]*Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]*
       (16*Mass["WBoson"]^4 - 13*Mass["WBoson"]^2*Mass["ZBoson"]^2)*
       Param["g1"])/(8*Sqrt[2]*Mass["ZBoson"]^4*Param["vev"]) + 
     Conjugate[WC["Hl1", {1, 2}]]*
      ((7*Conjugate[Upmns[2, pi]]*KroneckerDelta[si, ti]*
         Log[\[Mu]W^2/Mass["WBoson"]^2]*Mass["WBoson"]^4*
         (Mass["WBoson"] - Mass["ZBoson"])*(Mass["WBoson"] + Mass["ZBoson"]))/
        (2*Mass["ZBoson"]^4*Param["vev"]^2) + 
       (Conjugate[Upmns[2, pi]]*KroneckerDelta[si, ti]*
         Log[\[Mu]W^2/Mass["t"]^2]*(-64*Mass["WBoson"]^6 + 
          2*Mass["WBoson"]^2*(27*Mass["t"]^2 + 52*Mass["WBoson"]^2)*
           Mass["ZBoson"]^2 - (27*Mass["t"]^2 + 40*Mass["WBoson"]^2)*
           Mass["ZBoson"]^4))/(72*Mass["ZBoson"]^4*Param["vev"]^2) + 
       (Conjugate[Upmns[2, pi]]*KroneckerDelta[si, ti]*(8*Mass["WBoson"]^6 - 
