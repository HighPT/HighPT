       (3*Conjugate[Upmns[3, pi]]*KroneckerDelta[si, ti]*Mass["ZBoson"]^2)/
        (32*Param["vev"]^2))*Upmns[1, ri] + Conjugate[WC["Hl3", {1, 2}]]*
      ((3*Conjugate[Upmns[2, si]]*KroneckerDelta[pi, ti]*
         Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2)/(32*Param["vev"]^2) - 
