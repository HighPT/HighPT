OneLoopMatching[HighPT`PackageScope`WCLS["\[Nu]\[Nu]VLL", 
     {pi_, ri_, si_, ti_}]] := 
   (Conjugate[WC["uH", {3, 3}]]*
      ((3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
          KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*Mass["t"]^3)/
        (16*Sqrt[2]*Mass["H"]^2*Param["vev"]) + 
       (3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
          KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*
         Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^3)/(16*Sqrt[2]*Mass["H"]^2*
         Param["vev"])) + (3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
        KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*
       Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2*(Mass["H"]^2 - 4*Mass["t"]^2))/
      (32*Mass["H"]^2*Param["vev"]^4) - 
     (3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
        KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*
       Log[\[Mu]W^2/Mass["WBoson"]^2]*Mass["WBoson"]^2*
       (Mass["H"]^2 - 2*Mass["WBoson"]^2))/(32*Mass["H"]^2*Param["vev"]^4) + 
     (3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
        KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*
       Log[\[Mu]W^2/Mass["H"]^2]*Mass["H"]^2*(Mass["H"]^2 - 
        2*Mass["ZBoson"]^2))/(64*(Mass["H"]^2 - Mass["ZBoson"]^2)*
       Param["vev"]^4) + (3*(KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + 
        KroneckerDelta[pi, ri]*KroneckerDelta[si, ti])*
       Log[\[Mu]W^2/Mass["ZBoson"]^2]*Mass["ZBoson"]^4*
       (3*Mass["H"]^2 - 2*Mass["ZBoson"]^2))/(64*Mass["H"]^2*
       (Mass["H"]^2 - Mass["ZBoson"]^2)*Param["vev"]^4) + 
     ((KroneckerDelta[pi, ti]*KroneckerDelta[ri, si] + KroneckerDelta[pi, ri]*
         KroneckerDelta[si, ti])*(7*Mass["H"]^4 + Mass["H"]^2*
         (-4*Mass["WBoson"]^2 + Mass["ZBoson"]^2) + 
        4*(-12*Mass["t"]^4 + 2*Mass["WBoson"]^4 + Mass["ZBoson"]^4)))/
      (128*Mass["H"]^2*Param["vev"]^4) + Conjugate[WC["Hl1", {1, 2}]]*
      ((-3*Conjugate[Upmns[2, si]]*KroneckerDelta[pi, ti]*
         Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2)/(32*Param["vev"]^2) - 
       (3*Conjugate[Upmns[2, si]]*KroneckerDelta[pi, ti]*Mass["ZBoson"]^2)/
        (32*Param["vev"]^2))*Upmns[1, ri] + Conjugate[WC["Hl1", {1, 3}]]*
      ((-3*Conjugate[Upmns[3, si]]*KroneckerDelta[pi, ti]*
         Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2)/(32*Param["vev"]^2) - 
       (3*Conjugate[Upmns[3, si]]*KroneckerDelta[pi, ti]*Mass["ZBoson"]^2)/
        (32*Param["vev"]^2))*Upmns[1, ri] + Conjugate[WC["Hl1", {1, 2}]]*
      ((-3*Conjugate[Upmns[2, pi]]*KroneckerDelta[si, ti]*
         Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2)/(32*Param["vev"]^2) - 
       (3*Conjugate[Upmns[2, pi]]*KroneckerDelta[si, ti]*Mass["ZBoson"]^2)/
        (32*Param["vev"]^2))*Upmns[1, ri] + Conjugate[WC["Hl1", {1, 3}]]*
      ((-3*Conjugate[Upmns[3, pi]]*KroneckerDelta[si, ti]*
