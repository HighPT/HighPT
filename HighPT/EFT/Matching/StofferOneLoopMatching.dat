       Conjugate[WC["lq3", {1, 3, 3, 3}]]*KroneckerDelta[pi, ti]*
       Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2*Upmns[1, ri])/
      (32*Param["vev"]^2) + (3*Conjugate[Upmns[2, si]]*
       Conjugate[WC["lu", {1, 2, 3, 3}]]*KroneckerDelta[pi, ti]*
       Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2*Upmns[1, ri])/
      (32*Param["vev"]^2) + (3*Conjugate[Upmns[3, si]]*
       Conjugate[WC["lu", {1, 3, 3, 3}]]*KroneckerDelta[pi, ti]*
       Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2*Upmns[1, ri])/
      (32*Param["vev"]^2) - (3*Conjugate[Upmns[2, pi]]*
       Conjugate[WC["lq1", {1, 2, 3, 3}]]*KroneckerDelta[si, ti]*
       Log[\[Mu]W^2/Mass["t"]^2]*Mass["t"]^2*Upmns[1, ri])/
      (32*Param["vev"]^2) - (3*Conjugate[Upmns[3, pi]]*
