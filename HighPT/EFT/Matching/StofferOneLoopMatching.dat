      (16*Mass["H"]^2*Param["vev"]^2) + 
     (KroneckerDelta[pi, ri]*(4*Mass["H"]^4 + Mass["H"]^2*
         (6*Mass["WBoson"]^2 + Mass["ZBoson"]^2) + 
        4*(-12*Mass["t"]^4 + 2*Mass["WBoson"]^4 + Mass["ZBoson"]^4))*MNu[pi])/
