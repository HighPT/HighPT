Cell[CellGroupData[{
Cell["ChiSquareLHC", "ObjectName",
 CellID->244928800,ExpressionUUID->"59013a57-4cb2-4a67-bb4f-ae9f564a91ce"],

Cell[TextData[Cell[BoxData[
 ButtonBox["Nothing",
  BaseStyle->
   "Link"]], \
"InlineFormula",ExpressionUUID->"91d60bae-f1df-4389-b17a-f3863e7f8f0e"]], \
"Input",
 CellChangeTimes->{3.961747448525043*^9},
 CellID->460469386,ExpressionUUID->"e444628a-d654-4ee7-b687-0fd65f9a264c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f90bb8a8-64cd-4195-bb00-6f1b714b29ee"],
 "ChiSquareLHC[\"proc\"] computes the \!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\
\) likelihood for the process specified by the string \"proc\". The \
\!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\) is computed for each bin of the \
experimental search individually. Returned is a list of the \
\!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\) for all the experimental bins. The \
combined \!\(\*SuperscriptBox[\(\[Chi]\), \(2\)]\) can be obtained by \
Total[ChiSquareLHC[\"proc\"]]. The binning and all other relevant information \
is printed on the screen when evaluating ChiSquareLHC[\"proc\"]. The options \
and their default values are: FF \[Rule] False; Coefficients \[Rule] All; \
EFTorder \[RuleDelayed] GetEFTorder[]; OperatorDimension \[RuleDelayed] \
GetOperatorDimension[]; CombineBins \[Rule] Default; Luminosity \[Rule] \
Default; RescaleError \[Rule] True."
}], "Usage",
 CellID->1939673948,ExpressionUUID->"96e4b0cf-563f-455e-bd55-3dceee0023df"],

Cell["The following options can be given: ", "Notes",
 CellID->1298282576,ExpressionUUID->"49769b34-1fbd-4200-91c1-1c941ffebd99"],

Cell[BoxData[GridBox[{
